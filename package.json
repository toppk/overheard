{
  "name": "overheard",
  "version": "0.9.1",
  "private": true,
  "license": "ISC",
  "description": "Self-hosted voice rooms with per-speaker recording and offline transcription",
  "type": "module",
  "scripts": {
    "build:web": "astro build --root web",
    "dev:web": "astro dev --root web",
    "dev": "npm run build:web && tsx server/index.ts",
    "start": "npm run dev",
    "check": "tsc --noEmit",
    "test:loopback": "tsx scripts/loopback-test.ts"
  },
  "dependencies": {
    "@tursodatabase/database": "0.7.0",
    "express": "4.22.2",
    "mediasoup": "3.22.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "astro": "7.1.1",
    "mediasoup-client": "3.21.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
