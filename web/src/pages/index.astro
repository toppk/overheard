---
import '../styles/neon.css';
import '../styles/lobby.css';
import HelpDeck from '../components/HelpDeck.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>overheard // the grid</title>
  </head>
  <body class="lobby">
    <header class="grid-header">
    <h1>overheard // the grid</h1>
    <p class="grid-intro">Live voices. Recorded conversations. An open channel.</p>
    <details class="grid-fiction">
    <summary>Everyone sees everything; nothing is forgotten.</summary>
    <p class="narrative">
      The sky above the port is the color of a dead channel. You jack in.
      Constructs hang in the grid like lit windows — some hot with voices,
      some flatlined into cold storage, every word they ever held preserved.
      There is no ICE here. Everyone sees everything; nothing is forgotten.
    </p>
    </details>
    </header>

    <div class="panel" id="name-panel">
      <label for="name-input">handle, operator?</label>
      <div class="entry-controls">
        <input id="name-input" placeholder="your handle" autocomplete="name" />
        <button class="cmd" id="enter-btn">jack in</button>
      </div>
    </div>

    <div id="commons" style="display:none;">
      <div id="carrier" class="carrier" role="status" hidden></div>
      <div class="lobby-layout">
      <main>
      <section aria-labelledby="hot-heading">
      <div class="section-heading">
        <div><h2 id="hot-heading">hot constructs <span id="room-count" class="count"></span></h2>
        <p class="section-note">Find a voice room. Patch in and talk.</p></div>
        <button class="cmd primary" id="dig-btn">spin up a construct</button>
      </div>
      <p id="dig-hint" role="status" hidden></p>
      <ul id="rooms" class="room-list"><li class="empty-state">tuning into the grid…</li></ul>
      </section>

      <section class="cold-section" aria-labelledby="cold-heading">
      <div class="section-heading">
        <div><h2 id="cold-heading">cold storage</h2>
        <p class="section-note">Recordings from the last 24 hours.</p></div>
        <a class="act" href="/storage">browse the stacks</a>
      </div>
      <ul id="archives" class="room-list"><li class="empty-state">reading cold storage…</li></ul>
      <p class="section-note" id="storage-link"></p>
      </section>
      </main>
      <aside aria-labelledby="operators-heading">
      <h2 id="operators-heading">operators online <span id="user-count" class="count"></span></h2>
      <ul id="users"><li class="section-note">tuning in…</li></ul>
      </aside>
      </div>
      <details class="traffic">
      <summary>grid traffic <span class="section-note">— recent activity</span></summary>
      <div class="log panel" id="events"></div>
      </details>
    </div>

    <footer class="grid-footer">
      <span id="session-info" style="display:none;">
        <button class="cmd act" id="logout-btn">jack out of the grid</button>
        <button class="cmd act" id="chimes-btn">chimes: on</button>
        <button class="cmd act" id="pings-btn" aria-describedby="ping-hint">pings: off</button>
      </span>
      <HelpDeck />
      <p id="ping-hint" class="section-note" hidden></p>
    </footer>

    <script>
      import { diag, getHandle, setHandle, clearHandle } from '../lib/diag';
      import { chime, primeChimes, type ChimeKind } from '../lib/chimes';
      import { fmtAgo, fmtDur } from '../lib/ago';

      diag('page load: / (the grid)', { referrer: document.referrer || '(none)' });
      const namePanel = document.getElementById('name-panel')!;
      const commons = document.getElementById('commons')!;
      const nameInput = document.getElementById('name-input') as HTMLInputElement;
      nameInput.value = getHandle() ?? '';


      function textElement(tag: string, className: string, text: string) {
        const el = document.createElement(tag);
        el.className = className;
        el.textContent = text;
        return el;
      }

      // Native links make the entire record work with keyboard, touch,
      // modifier-click and the browser's open-in-new-tab menu.
      function roomLink(id: string, archive: boolean, action: string) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'room-link';
        a.href = `/${archive ? 'archive' : 'chat'}/${encodeURIComponent(id)}`;
        const body = textElement('div', 'room-body', '');
        body.append(textElement('h3', 'room-name', id));
        a.append(body, textElement('span', 'room-action cmd act', action));
        li.append(a);
        return { li, a, body };
      }

      function render(state: any) {
        lastState = state;
        // Keep the exact control, not merely its destination: several sidebar
        // operators and the main room row can all link to the same room.
        const focused = document.activeElement;
        const focusedList = focused instanceof HTMLAnchorElement
          ? focused.closest('#rooms, #archives, #users') : null;
        const focusedHref = focusedList ? focused?.getAttribute('href') : null;
        const focusedOperator = focused instanceof HTMLAnchorElement ? focused.dataset.operator : undefined;
        const inConstruct = new Map<string, string>();
        const away = new Set<string>();
        for (const room of state.rooms) {
          for (const p of room.participants) inConstruct.set(p, room.roomId);
          for (const p of room.away ?? []) away.add(p);
        }
        const users = document.getElementById('users')!;
        users.replaceChildren();
        const names = [...new Set<string>([...state.users, ...inConstruct.keys()])].sort(
          (a, b) => (a === myName ? -1 : b === myName ? 1 : a.localeCompare(b)),
        );
        document.getElementById('user-count')!.textContent = String(names.length);
        for (const name of names) {
          const li = document.createElement('li');
          li.append(textElement('div', 'operator-name', name + (name === myName ? ' (you)' : '')));
          const room = inConstruct.get(name);
          if (room) {
            const a = document.createElement('a');
            a.className = 'operator-room act';
            a.dataset.operator = name;
            a.href = `/chat/${encodeURIComponent(room)}`;
            a.textContent = `${away.has(name) ? 'away · ' : 'in '}${room}`;
            li.append(a);
          } else {
            li.append(textElement('span', 'section-note', 'in the lobby'));
          }
          users.append(li);
        }

        const rooms = document.getElementById('rooms')!;
        rooms.replaceChildren();
        document.getElementById('room-count')!.textContent = String(state.rooms.length);
        if (!state.rooms.length) {
          rooms.append(textElement('li', 'empty-state', 'No voices on channel. Spin up a construct to start talking.'));
        }
        for (const room of state.rooms) {
          const empty = !room.participants.length;
          const { li, a, body } = roomLink(room.roomId, false, empty ? 'patch back in' : 'patch in');
          a.classList.add(empty ? 'room-held' : 'room-live');
          const awaySet = new Set(room.away ?? []);
          body.append(textElement('p', 'room-people', empty ? 'channel empty' :
            room.participants.map((p: string) => p + (awaySet.has(p) ? ' (away)' : '')).join(', ')));
          const status = textElement('p', 'room-status', '');
          if (empty) {
            if (room.sealsAt) status.dataset.sealsAt = String(room.sealsAt);
            status.textContent = carrierLost ? 'countdown stale' : 'closing the tape…';
          } else {
            status.textContent = carrierLost ? 'last seen recording' : 'recording';
          }
          body.append(status);
          rooms.append(li);
        }
        refreshCountdowns();

        const archives = document.getElementById('archives')!;
        archives.replaceChildren();
        if (!state.archives.length) {
          archives.append(textElement('li', 'empty-state', 'No recordings in the last 24 hours. Older conversations are in the stacks.'));
        }
        document.getElementById('storage-link')!.textContent =
          `${state.archiveTotal ?? state.archives.length} constructs in cold storage`;
        for (const ar of state.archives) {
          const { li, body } = roomLink(ar.roomId, true, 'access tape');
          body.append(textElement('p', 'room-people', ar.participants.length ? ar.participants.join(', ') : 'no taped voices'));
          const meta = textElement('p', 'room-status', `flatlined ${fmtAgo(ar.endedAt)} · ${fmtDur(ar.durationMs)} · `);
          const label = ar.transcript === 'running' ? 'wintermute parsing…'
            : ar.transcript === 'failed' ? 'transcript failed'
            : ar.transcript === 'done' ? 'transcript ready' : 'no transcript yet';
          meta.append(textElement('span', ar.transcript === 'failed' ? 'status-failed' :
            ar.transcript === 'running' ? 'status-running' : '', label));
          body.append(meta);
          archives.append(li);
        }

        if (focusedList && focusedHref) {
          const links = focusedList.querySelectorAll<HTMLAnchorElement>('a');
          Array.from(links).find(a => a.getAttribute('href') === focusedHref &&
            a.dataset.operator === focusedOperator)?.focus({ preventScroll: true });
        }
        const events = document.getElementById('events')!;
        events.replaceChildren();
        for (const ev of [...state.events].reverse()) {
          events.append(textElement('div', '', ev.text));
        }
        signalNewEvents(state.events);
      }

      function refreshCountdowns() {
        document.querySelectorAll<HTMLElement>('[data-seals-at]').forEach(el => {
          const secs = Math.max(0, Math.ceil((Number(el.dataset.sealsAt) - Date.now()) / 1000));
          el.textContent = carrierLost ? 'countdown stale' :
            secs > 0 ? `flatlines in ~${secs}s` : 'waiting for seal…';
        });
      }
      window.setInterval(refreshCountdowns, 1000);

      // --- chimes & pings -------------------------------------------------
      let chimesOn = (localStorage.getItem('overheard-chimes') ?? '1') === '1';
      let pingsOn = localStorage.getItem('overheard-pings') === '1';
      let lastEventTs = -1; // -1: first state; baseline silently
      let myName = '';

      function classify(text: string): ChimeKind | null {
        if (text.includes('jacks into the grid')) return 'arrival';
        if (text.includes('spins up a construct')) return 'construct';
        if (text.includes('patches into')) return 'patch';
        return null;
      }

      function signalNewEvents(events: { ts: number; text: string }[]) {
        const maxTs = events.reduce((m, e) => Math.max(m, e.ts), 0);
        if (lastEventTs === -1) {
          lastEventTs = maxTs;
          return;
        }
        for (const ev of events) {
          if (ev.ts <= lastEventTs) continue;
          if (myName && ev.text.startsWith(`${myName} `)) continue; // your own noise
          const kind = classify(ev.text);
          if (!kind) continue;
          diag(`grid signal: ${kind} — ${ev.text}`);
          if (chimesOn) chime(kind);
          if (pingsOn && document.hidden && Notification.permission === 'granted') {
            new Notification('overheard // the grid', { body: ev.text, tag: 'overheard-grid' });
          }
        }
        lastEventTs = maxTs;
      }

      let ws: WebSocket | null = null;
      let reconnect = true;
      let reconnectTimer = 0;
      let lastState: any = null;
      let carrierLost = false;
      let darkSince = 0;
      let darkTimer = 0;
      const carrierEl = document.getElementById('carrier')!;

      function paintCarrier() {
        const secs = Math.round((Date.now() - darkSince) / 1000);
        carrierEl.textContent =
          `carrier lost — ${secs}s dark, retrying. what's below is a snapshot.`;
      }

      // A silent retry leaves a confident, frozen lobby on screen. Say the
      // line is down, and repaint so nothing keeps counting behind it.
      function setCarrier(lost: boolean) {
        if (lost === carrierLost) return;
        carrierLost = lost;
        carrierEl.hidden = !lost;
        if (lost) {
          darkSince = Date.now();
          paintCarrier();
          darkTimer = window.setInterval(paintCarrier, 1000);
        } else {
          clearInterval(darkTimer);
        }
        if (lastState) render(lastState);
      }

      function connect(name: string) {
        clearTimeout(reconnectTimer);
        const proto = location.protocol === 'https:' ? 'wss' : 'ws';
        diag(`lobby ws: connecting as ${JSON.stringify(name)}`);
        const socket = new WebSocket(`${proto}://${location.host}/ws`);
        ws = socket;
        socket.onopen = () => {
          if (ws !== socket || !reconnect) return;
          diag('lobby ws: open, sending lobby.join');
          socket.send(JSON.stringify({ type: 'lobby.join', requestId: 1, name }));
        };
        socket.onmessage = (ev) => {
          if (ws !== socket || !reconnect) return;
          const msg = JSON.parse(ev.data);
          const state = msg.type === 'lobby.state' ? msg
            : msg.type === 'response' && msg.data?.type === 'lobby.state' ? msg.data
            : null;
          if (state) {
            // The snapshot is current only after state arrives, not on open.
            lastState = null;
            setCarrier(false);
            diag('lobby.state received', {
              users: state.users.length,
              rooms: state.rooms.length,
              archives: state.archives.length,
            });
            render(state);
          }
        };
        socket.onclose = () => {
          if (ws !== socket) return;
          diag(`lobby ws: closed (reconnect=${reconnect})`);
          if (reconnect) {
            setCarrier(true);
            reconnectTimer = window.setTimeout(() => connect(name), 3000);
          }
        };
      }

      function enterGrid(name: string) {
        diag(`entering the grid as ${JSON.stringify(name)}`);
        myName = name;
        document.getElementById('session-info')!.style.display = 'inline';
        namePanel.style.display = 'none';
        commons.style.display = 'block';
        reconnect = true;
        connect(name);
      }

      document.getElementById('enter-btn')!.addEventListener('click', () => {
        const name = nameInput.value.trim();
        if (!name) {
          // Every operator carries a handle; unnamed entry is not a thing.
          diag('click: jack in with empty handle — refused, focusing input');
          nameInput.focus();
          return;
        }
        diag(`click: jack in (handle=${JSON.stringify(name)})`);
        setHandle(name);
        enterGrid(name);
      });
      nameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('enter-btn')!.click();
      });

      // Jacking out of the grid is the footer operation: burn the stored
      // handle and fall back to the login panel.
      document.getElementById('logout-btn')!.addEventListener('click', () => {
        diag('click: jack out of the grid');
        // Burning the handle kills auto-entry, but the login input still
        // remembers the last name used — convenience, not identity.
        const last = getHandle();
        if (last) localStorage.setItem('overheard-last-handle', last);
        clearHandle();
        reconnect = false;
        clearTimeout(reconnectTimer);
        ws?.close();
        ws = null;
        lastState = null;
        lastEventTs = -1;
        setCarrier(false);
        nameInput.value = last ?? '';
        commons.style.display = 'none';
        document.getElementById('session-info')!.style.display = 'none';
        namePanel.style.display = 'block';
      });

      // Chime/ping toggles. Clicking is also the user gesture that lets the
      // AudioContext start (needed when the lobby was entered without one).
      const chimesBtn = document.getElementById('chimes-btn') as HTMLButtonElement;
      const pingsBtn = document.getElementById('pings-btn') as HTMLButtonElement;
      const syncToggleLabels = () => {
        chimesBtn.textContent = `chimes: ${chimesOn ? 'on' : 'off'}`;
        chimesBtn.setAttribute('aria-pressed', String(chimesOn));
        // Pings has browser-owned states beyond on/off: surface them
        // instead of letting a click silently do nothing.
        if (!('Notification' in window)) {
          pingsBtn.textContent = 'pings: unavailable';
          pingsBtn.classList.add('danger');
          pingsBtn.title = 'this browser does not offer notifications here';
        } else if (Notification.permission === 'denied') {
          pingsBtn.textContent = 'pings: blocked';
          pingsBtn.classList.add('danger');
          pingsBtn.title =
            "notifications are denied in the browser's site settings — allow them there, then click again";
          if (pingsOn) {
            pingsOn = false;
            localStorage.setItem('overheard-pings', '0');
          }
        } else {
          pingsBtn.classList.remove('danger');
          pingsBtn.title = '';
          pingsBtn.textContent = `pings: ${pingsOn ? 'on' : 'off'}`;
        }
        pingsBtn.setAttribute('aria-pressed', String(pingsOn));
        const hint = document.getElementById('ping-hint')!;
        hint.textContent = pingsBtn.title;
        hint.hidden = !pingsBtn.title;
      };
      syncToggleLabels();
      // Permission can change in site settings while the tab is open.
      document.addEventListener('visibilitychange', syncToggleLabels);
      chimesBtn.addEventListener('click', () => {
        chimesOn = !chimesOn;
        localStorage.setItem('overheard-chimes', chimesOn ? '1' : '0');
        diag(`chimes ${chimesOn ? 'enabled' : 'disabled'}`);
        if (chimesOn) {
          primeChimes();
          chime('arrival'); // audible confirmation
        }
        syncToggleLabels();
      });
      pingsBtn.addEventListener('click', async () => {
        if (!('Notification' in window)) {
          diag('pings unavailable: no Notification API');
          return;
        }
        if (Notification.permission === 'denied') {
          // Re-check in case the user just unblocked in site settings.
          const perm = await Notification.requestPermission();
          diag(`pings blocked by browser site settings (recheck: ${perm})`);
          syncToggleLabels();
          return;
        }
        if (!pingsOn && Notification.permission !== 'granted') {
          const perm = await Notification.requestPermission();
          diag(`notification permission: ${perm}`);
          if (perm !== 'granted') {
            syncToggleLabels();
            return;
          }
        }
        pingsOn = !pingsOn;
        localStorage.setItem('overheard-pings', pingsOn ? '1' : '0');
        diag(`pings ${pingsOn ? 'enabled' : 'disabled'}`);
        syncToggleLabels();
      });
      // Any first interaction unlocks audio for auto-entered sessions.
      document.addEventListener('click', () => primeChimes(), { once: true });

      // With a stored handle, skip the login panel: arriving at / (including
      // returning from a construct) drops you straight into the lobby.
      const storedName = getHandle();
      if (storedName) {
        enterGrid(storedName);
      } else {
        const last = localStorage.getItem('overheard-last-handle');
        if (last) {
          nameInput.value = last;
          diag(`no stored handle: showing login panel (prefilled with last handle ${JSON.stringify(last)})`);
        } else {
          diag('no stored handle: showing login panel');
        }
      }

      document.getElementById('dig-btn')!.addEventListener('click', async () => {
        diag('click: spin up a construct');
        const button = document.getElementById('dig-btn') as HTMLButtonElement;
        const hint = document.getElementById('dig-hint')!;
        button.disabled = true;
        hint.hidden = false;
        hint.textContent = 'spinning up a construct…';
        try {
          const res = await fetch('/api/dig', { signal: AbortSignal.timeout(10000) });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const { roomId } = await res.json();
          if (typeof roomId !== 'string' || !roomId) throw new Error('missing construct name');
          location.href = `/chat/${encodeURIComponent(roomId)}`;
        } catch (error) {
          diag('construct could not be created', error);
          hint.textContent = 'could not reach the grid. try spinning up again.';
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
