---
import '../../styles/neon.css';
import '../../styles/records.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>overheard // the stacks</title>
  </head>
  <body class="stacks">
    <h1>cold storage // the stacks</h1>
    <p class="narrative">
      Every flatlined construct, kept exactly as it went to tape. Query the
      stacks; the daemon indexed every word.
    </p>

    <div class="panel search-panel">
      <label for="q" class="search-label">query the stacks</label>
      <input id="q" placeholder="a word or phrase from the tape…" style="width:100%;" />
      <div class="toggles" id="date-toggles">
        <span class="label">sealed</span>
        <button class="cmd toggle on" data-since="">all time</button>
        <button class="cmd toggle" data-since="86400000">24h</button>
        <button class="cmd toggle" data-since="604800000">7d</button>
        <button class="cmd toggle" data-since="2592000000">30d</button>
      </div>
      <div class="toggles" id="dur-toggles">
        <span class="label">ran for</span>
        <button class="cmd toggle on" data-min="" data-max="">any</button>
        <button class="cmd toggle" data-min="" data-max="300000">under 5m</button>
        <button class="cmd toggle" data-min="300000" data-max="1800000">5–30m</button>
        <button class="cmd toggle" data-min="1800000" data-max="">over 30m</button>
      </div>
      <div class="toggles" id="handle-toggles">
        <span class="label">voices</span>
        <span class="narrative">…</span>
      </div>
    </div>

    <div class="stacks-bar">
      <span class="narrative summary" id="summary">reading the stacks…</span>
      <button class="cmd" id="more-btn" style="display:none;">load more</button>
      <a href="/">// the grid</a>
    </div>

    <ul id="results" class="room-list"></ul>

    <style is:global>
      body.stacks { max-width: 62rem; padding: 0 2rem; --dim: #839ba8; }
      .stacks .search-panel { border: none; box-shadow: none; padding: 1.1rem; margin-top: 1.5rem; }
      .search-label { display: block; color: var(--cyan); font-size: 0.85rem; margin-bottom: 0.5rem; }
      .stacks input::placeholder { color: var(--dim); opacity: 1; }
      .stacks .toggles { gap: 0.35rem; }
      .stacks .toggle { border: 1px dotted var(--off); border-radius: 0; background: none; box-shadow: none; min-height: 0; line-height: 1.2; padding: 0.3em 0.7em; color: var(--text); text-shadow: none; }
      .stacks .toggle::before, .stacks .toggle::after { content: none; }
      .stacks .toggle.on { background: var(--cyan); color: var(--bg); border-color: var(--cyan); }
      .stacks .toggle:focus-visible { outline: 1px solid var(--cyan); outline-offset: 3px; }
      @media (hover: hover) {
        .stacks .toggle:hover { background: #14303a; color: var(--lit); }
        .stacks .toggle.on:hover { background: var(--lit); color: var(--bg); }
      }
      .stacks-bar { font-size: 0.85rem; }
      .stacks-bar > a, .stacks-bar > button { padding: 0.6rem 0; }
      @media (max-width: 560px) {
        body.stacks { padding: 0 1rem; }
        .stacks .toggles .label { flex-basis: 100%; margin-top: 0.5rem; }
      }
    </style>

    <script>
      import { diag } from '../../lib/diag';
      import { fmtAgo, fmtDur } from '../../lib/ago';

      diag('page load: /storage (the stacks)');
      const qInput = document.getElementById('q') as HTMLInputElement;
      const results = document.getElementById('results')!;
      const summary = document.getElementById('summary')!;
      const moreBtn = document.getElementById('more-btn') as HTMLButtonElement;

      const state = {
        q: '',
        sinceMs: '',
        minDurMs: '',
        maxDurMs: '',
        handles: new Set<string>(),
        offset: 0,
        total: 0,
      };

      // The search lives in the URL: refresh keeps it, the browser's back
      // button restores it exactly, and a query is a shareable address.
      const boot = new URLSearchParams(location.search);
      state.q = boot.get('q') ?? '';
      state.sinceMs = boot.get('sinceMs') ?? '';
      state.minDurMs = boot.get('minDurMs') ?? '';
      state.maxDurMs = boot.get('maxDurMs') ?? '';
      for (const h of (boot.get('handles') ?? '').split(',').filter(Boolean)) state.handles.add(h);
      qInput.value = state.q;
      const markOn = (containerId: string, match: (b: HTMLElement) => boolean) => {
        document.getElementById(containerId)!.querySelectorAll('.toggle').forEach((b) => {
          const on = match(b as HTMLElement);
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', String(on));
        });
      };
      markOn('date-toggles', (b) => (b.dataset.since ?? '') === state.sinceMs);
      markOn('dur-toggles', (b) => (b.dataset.min ?? '') === state.minDurMs && (b.dataset.max ?? '') === state.maxDurMs);

      const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      function renderRow(ar: any): HTMLLIElement {
        const li = document.createElement('li');
        const who = ar.participants.length ? ar.participants.map(esc).join(', ') : 'no taped voices';
        const status =
          ar.transcript === 'done' ? 'transcript ready'
          : ar.transcript === 'running' ? '<span class="status-running">wintermute parsing…</span>'
          : ar.transcript === 'failed' ? '<span class="status-failed">transcript failed</span>'
          : 'no transcript yet';
        const a = document.createElement('a');
        a.className = 'room-link';
        a.href = `/archive/${encodeURIComponent(ar.roomId)}`;
        const body = document.createElement('div');
        body.className = 'room-body';
        body.innerHTML = `<h3 class="room-name">${esc(ar.roomId)}</h3>` +
          `<p class="room-people">${who}</p>` +
          `<p class="room-status">flatlined ${fmtAgo(ar.endedAt)} · ${fmtDur(ar.durationMs)} · ${status}</p>`;
        const action = document.createElement('span');
        action.className = 'room-action cmd act';
        action.textContent = 'access tape';
        a.append(body, action);
        li.appendChild(a);
        if (ar.snippet) {
          const div = document.createElement('div');
          div.className = 'room-snippet';
          div.innerHTML = esc(ar.snippet)
            .replaceAll('\u0001', '<mark>')
            .replaceAll('\u0002', '</mark>');
          body.appendChild(div);
        }
        return li;
      }

      async function search(append = false) {
        if (!append) state.offset = 0;
        const params = new URLSearchParams();
        if (state.q) params.set('q', state.q);
        if (state.sinceMs) params.set('sinceMs', state.sinceMs);
        if (state.minDurMs) params.set('minDurMs', state.minDurMs);
        if (state.maxDurMs) params.set('maxDurMs', state.maxDurMs);
        if (state.handles.size) params.set('handles', [...state.handles].join(','));
        if (!append) {
          const qs = params.toString();
          history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
        }
        params.set('offset', String(state.offset));
        params.set('limit', '20');
        diag(`stacks query: ${params.toString()}`);
        const res = await fetch(`/api/storage?${params}`);
        if (!res.ok) {
          summary.textContent = 'the stacks did not answer. (query failed)';
          return;
        }
        const data = await res.json();
        state.total = data.total;
        if (!append) results.innerHTML = '';
        for (const ar of data.rows) results.appendChild(renderRow(ar));
        if (!data.total) {
          const empty = document.createElement('li');
          empty.className = 'empty-state';
          empty.textContent = 'no tapes match. try another query or open up the filters.';
          results.appendChild(empty);
        }
        state.offset += data.rows.length;
        const partial = state.offset < state.total ? ` · ${state.offset} pulled` : '';
        summary.textContent = `${state.total} construct${state.total === 1 ? ' matches' : 's match'}${state.q ? ` "${state.q}"` : ''}${partial}.`;
        moreBtn.textContent = `load ${Math.min(20, state.total - state.offset)} more`;
        moreBtn.style.display = state.offset < state.total ? 'inline' : 'none';
      }

      function wireSingleSelect(containerId: string, apply: (btn: HTMLElement) => void) {
        const container = document.getElementById(containerId)!;
        container.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.toggle') as HTMLElement | null;
          if (!btn) return;
          container.querySelectorAll('.toggle').forEach((b) => {
            b.classList.remove('on');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('on');
          btn.setAttribute('aria-pressed', 'true');
          apply(btn);
          search();
        });
      }
      wireSingleSelect('date-toggles', (btn) => (state.sinceMs = btn.dataset.since ?? ''));
      wireSingleSelect('dur-toggles', (btn) => {
        state.minDurMs = btn.dataset.min ?? '';
        state.maxDurMs = btn.dataset.max ?? '';
      });

      async function loadFacets() {
        const res = await fetch('/api/storage/facets');
        const { handles } = await res.json();
        const container = document.getElementById('handle-toggles')!;
        container.innerHTML = '<span class="label">voices</span>';
        if (!handles.length) {
          container.insertAdjacentHTML('beforeend', '<span class="narrative">no voices on record.</span>');
          return;
        }
        for (const h of handles) {
          const btn = document.createElement('button');
          btn.className = 'cmd toggle';
          btn.classList.toggle('on', state.handles.has(h.handle));
          btn.setAttribute('aria-pressed', String(state.handles.has(h.handle)));
          btn.textContent = `${h.handle} (${h.rooms})`;
          btn.addEventListener('click', () => {
            const on = btn.classList.toggle('on');
            btn.setAttribute('aria-pressed', String(on));
            if (on) state.handles.add(h.handle);
            else state.handles.delete(h.handle);
            search();
          });
          container.appendChild(btn);
        }
      }

      let debounce = 0;
      qInput.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = window.setTimeout(() => {
          state.q = qInput.value.trim();
          search();
        }, 250);
      });

      moreBtn.addEventListener('click', () => search(true));

      loadFacets();
      search();
    </script>
  </body>
</html>
