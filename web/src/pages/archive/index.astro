---
import '../../styles/neon.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>overheard // cold storage</title>
  </head>
  <body>
    <h1>cold storage // <span id="room-name"></span></h1>
    <p class="narrative">
      A flatlined construct. Its run is over; what was said inside is kept
      below, exactly as it went to tape.
    </p>

    <nav class="archive-nav" aria-label="archive navigation">
      <a href="/">back to the grid</a>
      <a href="#manifest" data-section-link="manifest">tape manifest</a>
      <a href="#transcript" data-section-link="transcript">transcript dump</a>
      <a href="#audio" data-section-link="audio" class="is-unavailable" aria-disabled="true" tabindex="-1">raw channels</a>
    </nav>

    <div id="content"><p class="narrative">reading cold storage…</p></div>

    <script>
      const roomId = location.pathname.split('/').filter(Boolean).pop()!;
      document.getElementById('room-name')!.textContent = roomId;
      const content = document.getElementById('content')!;
      const archiveNav = document.querySelector('.archive-nav')!;

      function updateSectionProgress() {
        const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
        const sections = links
          .map((link) => ({ link, section: document.getElementById(link.dataset.sectionLink!) }))
          .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(item.section));
        const readingLine = window.scrollY + archiveNav.getBoundingClientRect().height + 12;

        for (let i = 0; i < sections.length; i++) {
          const { link, section } = sections[i];
          const start = section.offsetTop;
          const end = sections[i + 1]?.section.offsetTop ?? document.documentElement.scrollHeight;
          const progress = Math.max(0, Math.min(100, ((readingLine - start) / Math.max(1, end - start)) * 100));
          const active = readingLine >= start && readingLine < end;
          link.classList.toggle('is-active', active);
          link.style.setProperty('--section-progress', `${active ? progress : 0}%`);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }
      addEventListener('scroll', updateSectionProgress, { passive: true });
      addEventListener('resize', updateSectionProgress);

      // Each speaker gets a stable color by order of appearance.
      const SPEAKER_COLORS = ['#4be4e4', '#e94fa1', '#9ece6a', '#e0af68', '#7aa2f7', '#f7768e'];
      function renderTranscript(md: string, metadata: any): HTMLElement {
        const box = document.createElement('div');
        box.className = 'transcript-view panel';
        const colorFor = new Map<string, string>();
        const speakerColor = (name: string) => {
          if (!colorFor.has(name)) {
            colorFor.set(name, SPEAKER_COLORS[colorFor.size % SPEAKER_COLORS.length]);
          }
          return colorFor.get(name)!;
        };
        // Seed colors in track order so they're stable across renders.
        for (const t of metadata.tracks ?? []) speakerColor(String(t.display_name));

        const names = [...colorFor.keys()].sort((a, b) => b.length - a.length);
        // The markdown ends with a "## raw channels" section for agents
        // fetching the .md; this page renders its own players for those.
        const body = md.replace(/\n---\s*\n+## raw channels\b[\s\S]*$/, '');
        for (const raw of body.split('\n')) {
          const line = raw.trimEnd();
          if (!line || line.startsWith('# ')) continue;

          const event = line.match(/^\*\[ (.+) — (\d\d:\d\d) \]\*$/);
          if (event) {
            const div = document.createElement('div');
            div.className = 'tr-event';
            const name = names.find((n) => event[1].startsWith(`${n} `));
            div.append('[ ');
            if (name) {
              const s = document.createElement('span');
              s.style.color = speakerColor(name);
              s.textContent = name;
              div.append(s, event[1].slice(name.length));
            } else {
              div.append(event[1]);
            }
            const ts = document.createElement('span');
            ts.className = 'tr-ts';
            ts.textContent = ` — ${event[2]} ]`;
            div.append(ts);
            box.appendChild(div);
            continue;
          }

          const speaker = line.match(/^\*\*(.+)\*\*$/);
          if (speaker) {
            const div = document.createElement('div');
            div.className = 'tr-speaker';
            div.style.color = speakerColor(speaker[1]);
            div.textContent = speaker[1];
            box.appendChild(div);
            continue;
          }

          const utterance = line.match(/^\((\d\d:\d\d)\) (.*)$/);
          if (utterance) {
            const div = document.createElement('div');
            div.className = 'tr-utterance';
            const ts = document.createElement('span');
            ts.className = 'tr-ts';
            ts.textContent = `(${utterance[1]}) `;
            div.append(ts);
            let text = utterance[2];
            const overlapped = text.endsWith('*[overlapping]*');
            if (overlapped) text = text.slice(0, -'*[overlapping]*'.length).trimEnd();
            div.append(text);
            if (overlapped) {
              const o = document.createElement('span');
              o.className = 'tr-overlap';
              o.textContent = ' [overlapping]';
              div.append(o);
            }
            box.appendChild(div);
            continue;
          }

          const div = document.createElement('div');
          div.textContent = line;
          box.appendChild(div);
        }
        return box;
      }

      async function load() {
        const res = await fetch(`/api/archives/${roomId}`);
        if (!res.ok) {
          content.innerHTML = '<p class="narrative">no such construct in cold storage.</p>';
          return;
        }
        const { metadata, transcript, conversation } = await res.json();
        content.innerHTML = '';

        const h2m = document.createElement('h2');
        h2m.id = 'manifest';
        h2m.textContent = 'tape manifest';
        content.appendChild(h2m);

        const info = document.createElement('div');
        info.className = 'panel';
        const started = new Date(metadata.started_at).toLocaleString();
        const mins = Math.max(1, Math.round(
          (new Date(metadata.ended_at).getTime() - new Date(metadata.started_at).getTime()) / 60000));
        const names = [...new Set(metadata.tracks.map((t: any) => t.display_name))].join(', ') || 'no one';
        info.innerHTML = `voices: ${names}<br>ran ${started} · ~${mins} min · ${metadata.tracks.length} taped channel(s)`;
        content.appendChild(info);

        const h2t = document.createElement('h2');
        h2t.id = 'transcript';
        h2t.textContent = 'transcript dump';
        content.appendChild(h2t);

        if (transcript === 'done' && conversation) {
          content.appendChild(renderTranscript(conversation, metadata));
          const links = document.createElement('p');
          links.innerHTML =
            `<a href="/archive/${roomId}.md">transcript (markdown)</a> ` +
            `<a href="/recordings/${roomId}/transcripts/canonical.json">structured dump (json)</a>`;
          content.appendChild(links);
        } else {
          const p = document.createElement('p');
          p.className = 'narrative';
          p.innerHTML =
            transcript === 'running' ? '<span class="status-running">wintermute is still parsing… (this page will refresh)</span>'
            : transcript === 'failed' ? '<span class="status-failed">wintermute choked on the tapes. </span>'
            : 'wintermute has not touched these tapes yet. ';
          content.appendChild(p);
          if (transcript === 'running') {
            setTimeout(load, 5000);
          } else if (metadata.tracks.length > 0) {
            const btn = document.createElement('button');
            btn.className = 'cmd';
            btn.textContent = 'wake wintermute';
            btn.addEventListener('click', async () => {
              await fetch(`/api/archives/${roomId}/transcribe`, { method: 'POST' });
              load();
            });
            p.appendChild(btn);
          }
        }

        if (metadata.tracks.length > 0) {
          const h2a = document.createElement('h2');
          h2a.id = 'audio';
          h2a.textContent = 'raw channels';
          content.appendChild(h2a);
          const audioLink = document.querySelector<HTMLAnchorElement>('[data-section-link="audio"]')!;
          audioLink.classList.remove('is-unavailable');
          audioLink.removeAttribute('aria-disabled');
          audioLink.removeAttribute('tabindex');
          for (const t of metadata.tracks) {
            const div = document.createElement('div');
            div.innerHTML = `${t.display_name} — on channel at +${Math.round(t.room_time_start_ms / 1000)}s`;
            const audio = document.createElement('audio');
            audio.controls = true;
            audio.src = `/recordings/${roomId}/${t.file}`;
            div.appendChild(audio);
            content.appendChild(div);
          }
        }
        updateSectionProgress();
      }
      load();
    </script>
  </body>
</html>
