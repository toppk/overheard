---
import '../../styles/neon.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>overheard // construct</title>
  </head>
  <body>
    <h1>construct <span id="room-name"></span></h1>

    <div class="panel" id="join-card">
      <p class="narrative">
        A live construct. Every channel inside is taped — every word kept on
        local iron. When the last operator drops the line, the construct
        flatlines into cold storage and wintermute parses the tapes. No
        second run.
      </p>
      <div style="display:flex; gap:0.6rem; align-items:center;">
        <input id="display-name" placeholder="alias inside this construct" autocomplete="off" />
        <button class="cmd" id="join-btn">patch in</button>
        <button class="cmd" id="change-handle-btn" style="display:none; font-size:0.85rem;">use an alias</button>
      </div>
      <p class="narrative" id="alias-note" style="display:none; margin:0.4rem 0 0; font-size:0.85rem;">
        the construct only ever knows the alias. your grid handle stays out of the tape.
      </p>
      <div class="narrative" id="status" style="margin-top:0.5rem;">carrier idle.</div>
      <div id="sealed-note" style="display:none; margin-top:0.5rem;">
        This construct flatlined. Its run is over and can't be restarted.
        <a id="sealed-link" href="#">access cold storage</a>
      </div>
    </div>

    <div class="panel" style="display:none;" id="call-card">
      <div class="narrative" id="status2">…</div>
      <div class="console">
        <div class="flow-row" id="tx-row">
          <span class="flow-arrow" id="tx-arrow">▲</span>
          <span class="flow-label">TX</span>
          <span class="meter" id="tx-meter"></span>
          <button class="cmd flow-toggle" id="mute-btn">silence your mic</button>
        </div>
        <div class="flow-row" id="rx-row">
          <span class="flow-arrow" id="rx-arrow">▼</span>
          <span class="flow-label">RX</span>
          <span class="meter" id="rx-meter"></span>
          <button class="cmd flow-toggle" id="deafen-btn">go deaf</button>
        </div>
      </div>
      <div id="carrier-note" class="status-failed" style="display:none; margin-top:0.4rem;"></div>
      <div id="blocked-note" class="status-failed" style="display:none; margin-top:0.4rem;">
        ⚠ incoming audio is being held by this device — tap anywhere to open the channel
      </div>
      <div class="narrative">the construct is taping every channel.</div>
      <h2>operators on channel</h2>
      <ul id="peers"></ul>
      <div style="margin-top:1.1rem; border-top:1px solid var(--border); padding-top:0.8rem;">
        <button class="cmd danger" id="leave-btn">drop the line</button>
      </div>
    </div>

    <p id="grid-link"><a href="/">// the grid</a></p>

    <script>
      import { Call } from '../../lib/call';
      import { diag, getHandle } from '../../lib/diag';

      const roomId = location.pathname.split('/').filter(Boolean).pop()!;
      diag(`page load: /chat/${roomId} (construct)`, { referrer: document.referrer || '(none)' });
      document.getElementById('room-name')!.textContent = roomId;

      const joinCard = document.getElementById('join-card')!;
      const callCard = document.getElementById('call-card')!;
      const statusEl = document.getElementById('status')!;
      const status2El = document.getElementById('status2')!;
      const peersEl = document.getElementById('peers')!;
      const nameInput = document.getElementById('display-name') as HTMLInputElement;
      const muteBtn = document.getElementById('mute-btn') as HTMLButtonElement;

      // Two identities, on purpose: the operator handle belongs to the grid;
      // inside a construct you can be whoever you want. The alias typed here
      // is used for this join only and is NEVER written back to the stored
      // handle — the tape records the alias, nothing links it to the grid.
      const storedHandle = getHandle();
      const joinBtn = document.getElementById('join-btn') as HTMLButtonElement;
      const changeBtn = document.getElementById('change-handle-btn') as HTMLButtonElement;
      nameInput.value = storedHandle ?? '';
      if (storedHandle) {
        nameInput.style.display = 'none';
        joinBtn.textContent = `patch in as ${storedHandle}`;
        changeBtn.style.display = 'inline';
      }
      nameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') joinBtn.click();
      });
      changeBtn.addEventListener('click', () => {
        diag('click: use an alias (revealing alias input)');
        nameInput.style.display = 'inline-block';
        nameInput.value = '';
        changeBtn.style.display = 'none';
        document.getElementById('alias-note')!.style.display = 'block';
        joinBtn.textContent = 'patch in';
        nameInput.focus();
      });

      const METER_CELLS = 16;
      function makeFlow(rowId: string, arrowId: string, meterId: string) {
        const row = document.getElementById(rowId)!;
        const arrow = document.getElementById(arrowId)!;
        const meterEl = document.getElementById(meterId)!;
        let lastN = -1;
        return {
          setOff(off: boolean) {
            row.classList.toggle('off', off);
          },
          draw(level: number) {
            const n = Math.round(level * METER_CELLS);
            arrow.style.transform = `scale(${1 + level * 0.6})`;
            arrow.style.textShadow = `0 0 ${4 + level * 22}px currentColor`;
            if (n === lastN) return;
            lastN = n;
            const main = Math.min(n, METER_CELLS - 3);
            const peak = Math.max(0, n - (METER_CELLS - 3));
            meterEl.innerHTML =
              '▕' + '█'.repeat(main) +
              `<span class="peak">${'█'.repeat(peak)}</span>` +
              '·'.repeat(METER_CELLS - main - peak) + '▏';
          },
        };
      }
      const tx = makeFlow('tx-row', 'tx-arrow', 'tx-meter');
      const rx = makeFlow('rx-row', 'rx-arrow', 'rx-meter');
      tx.draw(0);
      rx.draw(0);

      const call = new Call({
        onStatus: (s) => {
          diag(`call status: ${s}`);
          statusEl.textContent = s;
          status2El.textContent = s;
        },
        onPeerListChanged: (peers) => {
          peersEl.innerHTML = '';
          const me = document.createElement('li');
          me.textContent = `${nameInput.value || 'you'} (you)`;
          peersEl.appendChild(me);
          for (const p of [...peers].sort((a, b) => a.name.localeCompare(b.name))) {
            const li = document.createElement('li');
            li.textContent = p.name;
            peersEl.appendChild(li);
          }
        },
        onLevels: (txLevel, rxLevel) => {
          tx.draw(txLevel);
          rx.draw(rxLevel);
        },
        onCarrier: (problem) => {
          const note = document.getElementById('carrier-note')!;
          note.style.display = problem ? 'block' : 'none';
          note.textContent = problem ?? '';
        },
        onAudioBlocked: (blocked) => {
          document.getElementById('blocked-note')!.style.display = blocked ? 'block' : 'none';
        },
      });

      joinBtn.addEventListener('click', async () => {
        const name = nameInput.value.trim();
        if (!name) {
          // Every voice on tape carries a name — handle or alias.
          diag('click: patch in with empty name — refused, focusing input');
          nameInput.focus();
          return;
        }
        const aliased = name !== storedHandle;
        diag(`click: patch in (name=${JSON.stringify(name)}, ${aliased ? 'alias — grid handle untouched' : 'operator handle'})`);
        try {
          await call.join(roomId, name);
          diag('patched into construct successfully');
          joinCard.style.display = 'none';
          callCard.style.display = 'block';
          // On channel there is exactly one exit: drop the line.
          document.getElementById('grid-link')!.style.display = 'none';
        } catch (err) {
          const message = err instanceof Error ? err.message : String(err);
          diag(`join failed: ${message}`);
          if (message === 'sealed') {
            statusEl.textContent = '';
            const note = document.getElementById('sealed-note')!;
            note.style.display = 'block';
            (document.getElementById('sealed-link') as HTMLAnchorElement).href = `/archive/${roomId}`;
          } else {
            statusEl.textContent = `no carrier: ${message}`;
          }
        }
      });

      muteBtn.addEventListener('click', () => {
        const muted = call.toggleMute();
        diag(`click: ${muted ? 'silence mic (muted)' : 'open mic (unmuted)'}`);
        muteBtn.textContent = muted ? 'open your mic' : 'silence your mic';
        tx.setOff(muted);
      });

      const deafenBtn = document.getElementById('deafen-btn') as HTMLButtonElement;
      deafenBtn.addEventListener('click', () => {
        const deaf = call.toggleDeafen();
        diag(`click: ${deaf ? 'go deaf' : 'hear again'}`);
        deafenBtn.textContent = deaf ? 'hear again' : 'go deaf';
        rx.setOff(deaf);
      });

      document.getElementById('leave-btn')!.addEventListener('click', () => {
        diag('click: drop the line, leaving call and returning to the grid');
        call.leave();
        location.href = '/';
      });

      window.addEventListener('beforeunload', () => {
        diag('beforeunload: leaving call');
        call.leave();
      });
    </script>
  </body>
</html>
